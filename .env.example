# Copia este archivo como .env y completa los valores. .env nunca se sube a Git.
DB_MOTOR=sqlite
DB_NOMBRE=ecotech.db
DB_HOST=
DB_USUARIO=
DB_PASSWORD=
# python configurar.py genera esta clave si está vacía.
CLAVE_CIFRADO=
# Supabase > Project Settings > API. Ejemplo: https://abcd1234.supabase.co
SUPABASE_URL=
# Clave pública del proyecto (anon o publishable). No uses la service_role.
SUPABASE_KEY=
# Usuario creado en Supabase > Authentication > Users.
SUPABASE_EMAIL=
SUPABASE_PASSWORD=
SUPABASE_TABLA=empleados
